# The Lua libraries every game can require (lib/*.lua: juice, particles, physics, keyboard...), made into a C file
# the engine is built with, so they are there on the console, the desktop and the web without copying them.
# pinyol_embed_lib(<out.c> <lib dir>) writes it at configure time; editing a library configures again.
function(pinyol_embed_lib out dir)
  file(GLOB libs ${dir}/*.lua)
  list(SORT libs)
  set(c "/* Made by cmake/embed_lib.cmake from lib/<name>.lua: the libraries every game can require. */\n#include \"bp.h\"\n\n")
  set(table "")
  foreach(f ${libs})
    get_filename_component(name ${f} NAME_WE)
    file(READ ${f} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND c "static const char lib_${name}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", lib_${name}, sizeof lib_${name} - 1},\n")
  endforeach()
  string(APPEND c "\nconst pinyol_lib_entry pinyol_lib[] = {\n${table}    {0, 0, 0}};\n")
  file(WRITE ${out}.new "${c}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${out}.new ${out}) # (not rewritten: no rebuild)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${libs} ${dir})
endfunction()

# The pictures of the careta every game opens with (src/splash.c): packed pictures (.pk) and their .meta.json, made
# into a C file as the libraries are. pinyol_embed_pics(<out.c> <dir/ID>...) writes the table pinyol_splash[].
function(pinyol_embed_pics out)
  set(c "/* Made by cmake/embed_lib.cmake: the careta's pictures (tools/splash_art.py, firmware/cirera/art.py). */\n#include \"bp.h\"\n\n")
  set(table "")
  set(deps "")
  foreach(p ${ARGN})
    get_filename_component(name ${p} NAME)
    file(READ ${p}.pk hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(READ ${p}.meta.json mhex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," mbytes "${mhex}")
    # (aligned: the engine reads the column table in place, 4 bytes at a time)
    string(APPEND c "static _Alignas(4) const uint8_t pk_${name}[] = {${bytes}};\n")
    string(APPEND c "static const char meta_${name}[] = {${mbytes}0};\n")
    string(APPEND table "    {\"${name}\", pk_${name}, sizeof pk_${name}, meta_${name}},\n")
    list(APPEND deps ${p}.pk ${p}.meta.json)
  endforeach()
  string(APPEND c "\nconst pinyol_pic_entry pinyol_splash[] = {\n${table}    {0, 0, 0, 0}};\n")
  file(WRITE ${out}.new "${c}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${out}.new ${out})
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${deps})
endfunction()

# The careta's pictures: the seal and its label (splash/), the logo in pieces and the sky (the console menu's own)
macro(pinyol_splash_pics var root)
  set(${var} ${root}/splash/SEAL ${root}/splash/LABEL)
  foreach(id SKY INTRO_SEED SEED LEAVES INTRO_WORD WORD)
    list(APPEND ${var} ${root}/firmware/cirera/assets/${id})
  endforeach()
endmacro()
