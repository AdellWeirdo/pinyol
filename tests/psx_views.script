# The same logical point projected by three PS1-style cameras.
new
lua side = {kind = "side", ox = 40, oy = 220, forward = 2, depth = 0.5}
lua fixed = {kind = "fixed", ox = 240, oy = 100, basis = {1, 0.5, -0.25, 0.5}, scale = 1, grow = 0.01}
lua rear = {kind = "rear", ox = 240, horizon = 80, eye = 120, focal = 80, offset = 40}
lua sx, sy, sc, order = views.project(side, 10, 20, 30)
expect_lua sx == 80 and sy == 195 and sc == 1 and order == 10
lua sx, sy, sc, order = views.project(fixed, 10, 20, 30)
expect_lua sx == 260 and math.abs(sy - 71.5) < 0.001 and math.abs(sc - 1.2) < 0.001 and order == 20
lua sx, sy, sc, order = views.project(rear, 30, 40, 20)
expect_lua sx == 270 and sy == 180 and sc == 1 and order == -40
lua sx, sy, sc, order = views.project(rear, 30, 120, 20)
expect_lua sx == 255 and sy == 130 and sc == 0.5 and order == -120
expect_lua views.project(rear, 0, -40, 0) == nil
lua rear_fast = views.projector(rear)
lua side_fast = views.projector(side) fixed_fast = views.projector(fixed)
expect_lua select(1, side_fast(10, 20, 30)) == select(1, views.project(side, 10, 20, 30))
expect_lua select(2, fixed_fast(10, 20, 30)) == select(2, views.project(fixed, 10, 20, 30))
lua sx, sy, sc, order = rear_fast(30, 120, 20)
expect_lua sx == 255 and sy == 130 and sc == 0.5 and order == -120
lua rear.cz = 20
lua sx, sy, sc, order = rear_fast(30, 120, 20)
expect_lua math.abs(sx - 257.14285714286) < 0.00001 and math.abs(sy - 137.14285714286) < 0.00001 and math.abs(sc - 4 / 7) < 0.00001 and order == -120
lua rear.cx = 10
expect_lua math.abs(select(1, rear_fast(30, 120, 20)) - (240 + 80 / 7)) < 0.00001
lua rear.cx = nil
expect_lua rear_fast(0, 20, 0) == nil
lua rear.cz = nil
expect_lua_error views.projector({kind = "rear", focal = 0})
expect_lua_error views.projector({kind = "rear", max_scale = 0})
expect_lua_error views.project({kind = "rear", max_scale = -1}, 0, 10, 0)
expect_lua_error rear_fast(0 / 0, 120, 0)
lua zones = {{id = "side", z0 = 0, z1 = 100}, {id = "fixed", z0 = 100, z1 = 200}, {id = "rear", z0 = 200, z1 = 320}}
expect_lua views.pick(zones, 0, 99) == "side" and views.pick(zones, 0, 100) == "fixed" and views.pick(zones, 0, 200) == "rear"
expect_lua views.pick(zones, 0, 320) == nil and views.pick(zones, 0, 320, "end") == "end"
expect_lua_error views.project({kind = "rear", focal = 0}, 0, 10, 0)
expect_lua_error views.project({kind = "fixed", basis = {1, 2}}, 0, 10, 0)
expect_lua_error views.project({kind = "unknown"}, 0, 10, 0)
# draw3d: intercept quad so these Lua assertions do not depend on the parallel C change.
lua old_quad = quad calls3d = {} quad = function(...) calls3d[#calls3d + 1] = {...} end
lua cam3d = {kind = "rear", ox = 100, horizon = 20, eye = 0, focal = 100, offset = 0, near = 10}
lua face3d = function(id, z, opts) return {id = id, corners = {{x = 0, z = z, h = 0, u = 0, v = 0}, {x = 10, z = z, h = 0, u = 1, v = 0}, {x = 10, z = z, h = 10, u = 1, v = 1}, {x = 0, z = z, h = 10, u = 0, v = 1}}, opts = opts} end
lua views.draw3d(cam3d, {face3d("near", 20, {light = 17}), face3d("far", 40), face3d("tie", 40)})
expect_lua calls3d[4] == nil and calls3d[1][1] == "far" and calls3d[2][1] == "tie" and calls3d[3][1] == "near"
expect_lua calls3d[3][2] == 100 and calls3d[3][3] == 20 and calls3d[3][4] == 140 and calls3d[3][7] == -20
expect_lua calls3d[3][10].light == 17 and calls3d[3][10].uv[1] == 0 and calls3d[3][10].uv[7] == 0
lua calls3d = {} views.draw3d({kind = "fixed"}, {face3d("fixed_near", 40), face3d("fixed_far", 20)})
expect_lua calls3d[1][1] == "fixed_far" and calls3d[2][1] == "fixed_near"
lua side_far = face3d("side_far", 20) side_near = face3d("side_near", 20)
lua for _,v in ipairs(side_far.corners) do v.x = v.x - 20 end for _,v in ipairs(side_near.corners) do v.x = v.x + 20 end
lua calls3d = {} views.draw3d({kind = "side"}, {side_near, side_far})
expect_lua calls3d[1][1] == "side_far" and calls3d[2][1] == "side_near"
lua calls3d = {} views.draw3d(cam3d, {face3d("near", 20, {light = 17}), face3d("far", 40), face3d("tie", 40)})
lua original_opts = {light = 12, uv = {9}} views.draw3d(cam3d, {face3d("copy", 20, original_opts)})
expect_lua original_opts.uv[1] == 9 and calls3d[4][10].uv[1] == 0 and calls3d[4][10].light == 12
lua clipped = face3d("clip", 20) clipped.corners[1].z = 0 calls3d = {}
lua views.draw3d(cam3d, {clipped})
expect_lua calls3d[3] ~= nil and calls3d[4] == nil and calls3d[1][1] == "clip" and calls3d[1][10].uv[1] == 0 and calls3d[1][10].uv[2] == 0.5 and calls3d[1][10].uv[3] == 0.5
expect_lua calls3d[1][2] == 100 and calls3d[1][3] == 0 and calls3d[1][8] == calls3d[1][6] and calls3d[1][9] == calls3d[1][7]
lua clipped.corners[4].z = 0 calls3d = {} views.draw3d(cam3d, {clipped})
expect_lua calls3d[2] ~= nil and calls3d[3] == nil and calls3d[1][8] == calls3d[1][6]
lua calls3d = {} views.draw3d(cam3d, {face3d("hidden", 0)})
expect_lua calls3d[1] == nil
lua calls3d = {} views.draw3d(cam3d, {face3d("on_plane", 10)})
expect_lua calls3d[1][1] == "on_plane"
expect_lua_error views.draw3d(cam3d, {{id = "lit", corners = clipped.corners, opts = {lights = {0, 0, 0, 0}}}})
expect_lua_error views.draw3d({kind = "unknown"}, {})
lua bad_uv = face3d("bad", 20) bad_uv.corners[2].u = 0 / 0
expect_lua_error views.draw3d(cam3d, {bad_uv})
expect_lua_error views.draw3d(cam3d, {face3d("bad", 20, false)})
expect_lua_error views.draw3d(cam3d, {face3d(5, 20)})
expect_lua_error views.draw3d({kind = "rear", near = 0}, {})
# Sprites and polygon faces share painter order. A sprite behind the near plane is culled.
lua calls3d = {} draw_sprite3d = function(x,y,s) calls3d[#calls3d + 1] = {"sprite",x,y,s} end
lua views.draw3d(cam3d, {face3d("front_face",20), {draw=draw_sprite3d,x=5,z=40,h=0}, face3d("back_face",60), {draw=draw_sprite3d,x=5,z=0,h=0}})
expect_lua calls3d[4] == nil and calls3d[3] ~= nil and calls3d[1][1] == "back_face" and calls3d[2][1] == "sprite" and calls3d[3][1] == "front_face"
expect_lua calls3d[2][2] == 112.5 and calls3d[2][3] == 20 and calls3d[2][4] == 2.5
expect_lua_error views.draw3d(cam3d, {{draw=true,x=0,z=20}})
expect_lua_error views.draw3d(cam3d, {{draw=draw_sprite3d,x=0,z=0/0}})
lua quad = old_quad
# One actor and one persistent value survive both camera cuts.
shot lateral
lua actor.miseria = 57 actor.x = 30
hold RIGHT 42
tick 30
expect_lua zone == "fixed" and actor.z >= 100 and actor.x == 30 and actor.miseria == 57 and not transition.active()
shot fija
hold RIGHT 42
tick 30
expect_lua zone == "rear" and actor.z >= 200 and actor.x == 30 and actor.miseria == 57 and not transition.active()
shot trasera
hold LEFT 42
tick 30
expect_lua zone == "fixed" and actor.z < 200 and actor.miseria == 57
expect_ok
