# Malabarista: the clock, game A (every catch, the balls grow to three, the bonus at 100), three misses, game B, the explainer
tick 30
expect_lua state == "clock"
shot reloj
press A
tick 5
expect_lua state == "play" and mode == "A" and score == 0
shot a0
# a pilot that presses only the hand a ball has reached: every ball is caught
lua ob = btn; pilot = true; function btn(n) if pilot and (n == "left" or n == "right") then local want = n == "left" and 1 or 2; for _, b in ipairs(balls) do if b.k == 6 and (b.dir == 1 and 2 or 1) == want then return true end end return false end return ob(n) end
tick 700
expect_lua score >= 4 and misses == 0
shot a1
tick 2400
expect_lua score >= 10 and achievements()[1].done == true
tick 6000
expect_lua score >= 30 and balls_n == 3 and balls[3] ~= nil
shot a3
# both hands held catches nothing (it used to catch everything): three misses and it is over
lua pilot = false
hold LEFT+RIGHT 1800
expect_lua state == "over" and misses == 3
shot fin
press B
tick 5
expect_lua state == "play" and mode == "B" and balls_n == 3
lua pilot = true
tick 400
expect_lua score >= 3
shot b
press START
tick 3
expect_lua state == "clock"
lua require("explain").enter() state = "explain"
tick 3
shot e1
press RIGHT
tick 3
shot e2
press A
tick 3
press RIGHT
tick 40
shot e3
press RIGHT
tick 3
press DOWN
press A
tick 3
shot e4
press START
tick 3
expect_lua state == "clock"
expect_ok
