# The console's menu over a Lua game (src/sysmenu.c): a tap of MENU pauses it, its items, the settings, the crash screen
new
lua n = 0
tick 10
expect_lua n == 10
# a tap of MENU: the game sees MENU down for one tick, then the menu opens and it stops counting; _pause ran
press MENU
expect_menu open
tick 5
expect_lua n == 11 and paused == 1 and resumed == 0
shot sysmenu_open
# DOWN to the game's item, A chooses it: the menu closes first, then the item runs
lua n = 0
press DOWN
press A
expect_menu closed
expect_lua rang == true and resumed == 1
tick 5
expect_lua n == 6
# the settings page (Seguir, Sonar, Reiniciar, Ajustes); B goes back, B closes
press MENU
press DOWN
press DOWN
press DOWN
press A
shot sysmenu_settings
press B
press B
expect_menu closed
# Reiniciar: the game starts again (n back to 0, its item set again by _init)
press MENU
press DOWN
press DOWN
press A
expect_menu closed
tick 3
expect_lua n == 4 and rang == false
# menuitem(label) takes an item away and menuitem() all of them (both failed while an item existed to take away)
lua other = false; menuitem("Otra", function() other = true end); menuitem("Sonar")
tick 60
press MENU
press DOWN
press A
expect_menu closed
expect_lua other == true and rang == false
lua menuitem()
tick 60
press MENU
press DOWN
press A
expect_menu closed
tick 3
expect_lua n == 4 and rang == false
# a game that reads MENU keeps its taps; MENU held a second opens the menu anyway, and letting go then does not close it
lua read_menu = true
press MENU
expect_menu closed
hold MENU 70
expect_menu open
expect_lua held_menu == true
tick 2
expect_menu open
press B
expect_menu closed
# the speed: at 50% the game gets one tick in two, and a press on a skipped tick is not lost
settings speed 50
lua n = 0
tick 20
expect_lua n == 10
lua last = nil
press A
tick 4
expect_lua last == "a"
settings speed 100
# A and B swapped by the console
settings swap_ab true
lua last = nil
press A
expect_lua last == "b"
settings swap_ab false
# the buttons' map: with "BCA", A does B, B does C and C does A; and sticky buttons: a press of A holds it until the next
settings buttons BCA
lua last = nil
press B
expect_lua last == nil
press A
expect_lua last == "b" and settings().buttons == "BCA"
settings buttons ABC
settings hold toggle
lua last = nil; held_a = 0
lua _old_update = _update; _update = function() _old_update() if btn("a") then held_a = held_a + 1 end end
press A
tick 5
expect_lua last == "a" and held_a >= 5 and settings().sticky == true
press A
lua held_a = 0
tick 5
expect_lua held_a == 0
settings hold press
lua _update = _old_update
# settings() as the game reads them; the colour filter on the world
settings flash less
settings colour protan
expect_lua settings().reduce_flashing == true and settings().colour == "protan" and settings().swap_ab == false and settings().speed == 100 and settings().buttons == "ABC" and settings().sticky == false
tick 1
shot sysmenu_protan
settings colour normal
settings flash normal
# the crash screen: the whole error; A starts the game again, fresh
lua crash = true
allow_crash
tick 1
expect_crashed
shot sysmenu_crash
tick 3
expect_crashed
press A
tick 2
expect_ok
expect_lua n == 3 and crash == false
# `in N SPEC [X Y ...]`: exactly that input for N ticks, what --record writes: buttons, and a finger
lua last = nil
in 2 A
expect_lua last == "a"
in 3 -
lua last = nil
in 1 B+RIGHT
expect_lua last == "b"
in 2 - 240 160
expect_lua touched == true
in 1 -
expect_ok
