# quad lays a picture's frame on four corners: straight, it is the picture; its two triangles share a diagonal without
# a hole or a pixel mixed twice; turned a quarter it is the picture turned; lit, it darkens, brightens and blends
new
tick 2
# straight: every pixel as img draws it
expect_lua same("FLAT", "PLAIN") == 0
# a quarter-mix of white over nothing: all 256 pixels, all the same, none outside (no hole, none mixed twice)
expect_lua count("MIXED") == 256
expect_lua select(2, count("MIXED")) == select(3, count("MIXED"))
# turned a quarter: the picture's pixels, moved
expect_lua turned_wrong() == 0
# light 0 is black, 0x808080 is the picture, 0xFFFFFF doubles (a grey of 0x42 is about 0x84)
expect_lua pget(10, 10, "DARK") == 0x000000
expect_lua same("NEUTRAL", "PLAIN") == 0
expect_lua red("BRIGHT", 10, 10) > 0x78 and red("BRIGHT", 10, 10) < 0x90
# lit across: black on the left, as it is on the right, between in the middle
expect_lua red("RAMP", 4, 10) < 24 and red("RAMP", 19, 10) > 232 and red("RAMP", 12, 10) > 90 and red("RAMP", 12, 10) < 170
# far off the canvas: clipped, every pixel the picture's, nothing to crash
expect_lua count("FAR") == 1024
# grad: near black at the top to near white at the bottom, level along each row, never darker going down
expect_lua red("GV", 5, 0) < 8 and red("GV", 5, 31) > 247 and ramp_wrong() == 0
expect_lua red("GH", 0, 5) < 8 and red("GH", 31, 5) > 247 and red("GH", 10, 5) < red("GH", 20, 5)
# dithered: a row is no longer level, no pixel is far from the plain ramp, and the average is the same
expect_lua spread("GVD", 16) > 1 and far_from_plain() < 12 and math.abs(mean("GVD") - mean("GV")) < 3
# sub over white: the red taken away from the top (none) to the bottom (all of it)
expect_lua pget(5, 0, "GSUB") ~= nil and red("GSUB", 5, 31) < 20 and red("GSUB", 5, 0) > 235
# perspective: the middle of the picture lands a third of the way down the trapezoid (not half), straight edges either way
# (the affine one splits at y 150, the perspective one at about 133)
expect_lua red("P0", 200, 125) == 255 and red("P0", 200, 140) == 255 and red("P0", 200, 160) == 0 and grn("P0", 200, 160) == 255
expect_lua red("P1", 200, 125) == 255 and red("P1", 200, 140) == 0 and grn("P1", 200, 140) == 255 and grn("P1", 200, 160) == 255
expect_lua red("P8", 200, 140) == 0 and grn("P8", 200, 140) == 255 and red("P8", 200, 125) == 255
# the sides stay on the quad's edges: at y 150 the width is 125 (from 125 to 275), nothing outside it, all of it inside
expect_lua red("P1", 121, 150) + grn("P1", 121, 150) == 0 and red("P1", 129, 150) + grn("P1", 129, 150) > 0 and red("P1", 271, 150) + grn("P1", 271, 150) > 0 and red("P1", 279, 150) + grn("P1", 279, 150) == 0
shot quad
expect_ok
