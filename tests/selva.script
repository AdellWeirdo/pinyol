# Selva: a runner drawn with mesh(): the title plays itself, the fox steers, jumps, lands on crates, spins through them, bumps into them,
# picks up fruit, falls into a pit, is hurt by spikes, loses its three lives; "Cómo funciona" from the console's menu switches the tricks.
new
tick 60
expect_lua state == "title"
shot selva_titulo
lua W = require("world") V = require("view") M = require("music") z0 = fox.z
expect_lua M.mode == "soft"
tick 120
expect_lua fox.z > z0 + 200 and W.lives == 3
press A
tick 3
expect_lua state == "play" and W.lives == 3 and W.fruit == 0 and fox.y == 0 and M.mode == "full"
shot selva_correr
# the feel of the jump: a short press makes a lower jump than a held one; a press a little early waits for the ground; the edge of a pit still holds
lua W.items = {} fox.x = 0
tick 5
press A
tick 6
lua short_vy = fox.vy fox.y = 0 fox.vy = 0 fox.coyote = 6 fox.cut = false
tick 20
hold A 7
expect_lua short_vy < fox.vy
tick 60
lua fox.y = 8 fox.vy = -1.5 fox.coyote = 0 fox.cut = false
press A
tick 8
expect_lua fox.y > 3
tick 60
lua W.items = {{k = "pit", x = 0, z = fox.z - 4, y = 0, alive = true}} fox.coyote = 6
tick 2
press A
tick 4
expect_lua fox.state == "run" and fox.y > 0
tick 60
lua W.items = {}
# steer: right, then left, held; the fox keeps to the way
hold RIGHT 25
expect_lua fox.x > 10 and fox.x <= W.HALF
hold LEFT 60
expect_lua fox.x < -10 and fox.x >= -W.HALF
# a fruit where the fox runs: picked up (the first achievement)
lua W.items = {{k = "fruit", x = fox.x, z = fox.z + 8, y = 4, alive = true}}
tick 8
expect_lua W.fruit == 1 and achievements()[1].done == true
# landing on a crate breaks it, bounces the fox, and counts (the second achievement)
lua W.items = {{k = "crate", x = fox.x, z = fox.z + 4, y = 0, alive = true}} fox.y = 30 fox.vy = -2
tick 3
expect_lua W.crates == 1 and W.items[1].alive == false and fox.vy > 0 and achievements()[2].done == true and W.combo == 1
# three stomps without touching the ground: a streak (the third achievement)
lua W.combo = 2 W.items = {{k = "crate", x = fox.x, z = fox.z + 4, y = 0, alive = true}} fox.y = 30 fox.vy = -2
tick 3
expect_lua W.combo == 3 and achievements()[3].done == true
shot selva_racha
# a spin breaks a crate in its way
tick 80
lua W.items = {{k = "crate", x = fox.x, z = fox.z + 14, y = 0, alive = true}} fox.y = 0 fox.vy = 0
press B
tick 12
expect_lua W.items[1].alive == false and W.crates == 3
shot selva_remolino
# run into a crate: bumped, no life lost
tick 40
lua W.items = {{k = "crate", x = fox.x, z = fox.z + 16, y = 0, alive = true}} bumps = 0
tick 12
expect_lua fox.bump > 0 and W.lives == 3 and W.items[1].alive == true
# a jump clears a crate
tick 30
lua fox.bump = 0 W.items = {{k = "crate", x = fox.x, z = fox.z + 50, y = 0, alive = true}}
tick 4
press A
tick 50
expect_lua W.lives == 3
# a pit: over it the fox falls, loses a life, and is put back on the way
lua fox.bump = 0 W.speed = 2.4 W.items = {{k = "pit", x = 0, z = fox.z + 20, y = 0, alive = true}}
tick 28
expect_lua fox.state == "fall"
shot selva_foso
tick 14
expect_lua W.lives == 2 and fox.state == "run" and fox.y == 0 and fox.blink > 80
lua W.items = {}
# spikes cost a life and the fox hops; it is safe while it blinks
tick 110
lua W.items = {{k = "spike", x = fox.x, z = fox.z + 6, y = 0, alive = true}}
tick 8
expect_lua W.lives == 1 and fox.blink > 0
# the last life: game over, the record kept, back to the title with A
tick 110
lua W.items = {{k = "spike", x = fox.x, z = fox.z + 6, y = 0, alive = true}} W.dist = 6500
tick 8
expect_lua state == "over" and W.lives == 0 and achievements()[5].done == true and M.mode == nil
shot selva_fin
tick 60
press A
tick 3
expect_lua state == "title"
# "Cómo funciona": the console's menu, its item, the switches (each changes what the scene does), back with B
press A
tick 60
press MENU
tick 3
expect_menu open
press DOWN
press A
tick 4
expect_lua state == "explain" and achievements()[4].done == true and V.snap == true
tick 30
shot selva_como
press A
tick 2
expect_lua V.snap == false and V.dither == true
press DOWN
press A
tick 2
expect_lua V.dither == false
press DOWN
press A
tick 2
expect_lua V.fog == false
shot selva_sin_trucos
press UP
press A
press UP
press A
press DOWN
press DOWN
press A
tick 2
expect_lua V.snap == true and V.dither == true and V.fog == true
press DOWN
press DOWN
expect_lua M.on == true
press A
tick 2
expect_lua M.on == false
press A
tick 2
expect_lua M.on == true
press B
tick 3
expect_lua state == "play"
# the three languages
lua lang = require("lang") lang.set("ca")
expect_lua lang.tr("press") == "PREM A"
lua lang.set("en")
expect_lua lang.tr("press") == "PRESS A"
lua lang.set("es")
expect_lua lang.tr("press") == "PULSA A"

# the rules, without drawing: the attract mode's player runs twelve seeds for a long while (every pattern, pits, spikes, crates): no error, the fox
# keeps to the way, the lives and the lists stay sane, and it does get somewhere
lua function count(t) local n = 0 for _ in ipairs(t) do n = n + 1 end return n end
lua function sane() return math.abs(W.fox.x) <= W.HALF + 0.01 and W.lives >= 0 and count(W.items) < 120 end
lua function run_seed(seed) W.new(seed) for i = 1, 1500 do if W.over then return end W.update(W.ai_input()) assert(sane(), "seed " .. seed .. " tick " .. i) end end
lua W.hook = function() end far = 0
lua run_seed(1) far = math.max(far, W.dist)
lua run_seed(2) far = math.max(far, W.dist)
lua run_seed(3) far = math.max(far, W.dist)
lua run_seed(4) far = math.max(far, W.dist)
lua run_seed(5) far = math.max(far, W.dist)
lua run_seed(6) far = math.max(far, W.dist)
lua run_seed(7) far = math.max(far, W.dist)
lua run_seed(8) far = math.max(far, W.dist)
lua run_seed(9) far = math.max(far, W.dist)
lua run_seed(10) far = math.max(far, W.dist)
lua run_seed(11) far = math.max(far, W.dist)
lua run_seed(12) far = math.max(far, W.dist)
lua W.new(7) fox = W.fox
expect_lua far > 3000 and W.lives == 3 and W.dist == 0
