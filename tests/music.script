# music() told its bar: music_beat() counts bars and beats as the player hears them; a song with at = "bar" waits for the
# bar line of the one playing and starts there (music_queued() meanwhile); music() with nothing stops it all
new
expect_lua music_beat() == nil
lua music("BEAT", 0, {bar = 0.5, beats = 2})
tick 3
lua bar, beat, frac = music_beat()
expect_lua bar == 1 and beat == 1 and frac >= 0 and frac < 1
tick 20
lua bar, beat, frac = music_beat()
expect_lua bar == 1 and beat == 2
lua music("BEAT", 0, {at = "bar", bar = 0.5, beats = 2})
expect_lua music_queued() == true
tick 2
expect_lua music_queued() == true and music_time() > 0.3
tick 10
expect_lua music_queued() == false and music_time() < 0.25
lua music("BEAT", 0, {at = "bar"})
expect_lua music_queued() == true
lua music()
expect_lua music_queued() == false
tick 2
expect_lua music_beat() == nil
# the stop lands on the bar line and fades: once it is gone, a song with at = "bar" starts at once
tick 70
lua music("BEAT", 0, {at = "bar", bar = 0.5})
expect_lua music_queued() == false and music_time() ~= nil
lua music()
tick 70
# A module too: its bar is sixteen lines (four beats of four), no `bar` needed. LOOP.mod runs at speed 1 (a line every
# 20 ms, a bar 320 ms). at = "bar" waits for the line; music(nil, fade, {at = "bar"}) plays to the line and stops there.
lua music("LOOP")
tick 2
lua bar, beat, frac = music_beat()
expect_lua bar == 1 and beat == 1 and frac >= 0 and frac <= 1
tick 6
lua bar, beat = music_beat()
expect_lua bar == 1 and beat == 2
lua music("LOOP", 0, {at = "bar"})
expect_lua music_queued() == true
tick 4
expect_lua music_queued() == true
tick 10
lua bar, beat = music_beat()
expect_lua music_queued() == false and bar == 1 and beat <= 2
lua music(nil, 0, {at = "bar"})
tick 2
expect_lua music_beat() ~= nil
tick 24
expect_lua music_beat() == nil
# An XM (LOOPX.xm) and an S3M (LOOPS.s3m), by IBXM: the same lines, bars, queue and stop at the bar
lua music("LOOPX")
tick 2
lua bar, beat, frac = music_beat()
expect_lua bar == 1 and beat == 1 and frac >= 0 and frac <= 1
tick 6
lua bar, beat = music_beat()
expect_lua bar == 1 and beat == 2
lua music("LOOPS", 0, {at = "bar"})
expect_lua music_queued() == true
tick 4
expect_lua music_queued() == true
tick 10
lua bar, beat = music_beat()
expect_lua music_queued() == false and bar == 1 and beat <= 2
lua music(nil, 0, {at = "bar"})
tick 2
expect_lua music_beat() ~= nil
tick 24
expect_lua music_beat() == nil
lua music("LOOPS")
tick 8
lua bar, beat = music_beat()
expect_lua bar == 1 and beat == 2
lua music()
tick 70
# A WAV's own markers (MARKED.wav: a loop from 0.25 s in its smpl chunk, cue points at 0 and 0.5 s) serve when music() is
# told no bar nor loop_at: music_beat() counts bars of half a second, and the song goes round to 0.25 s
lua music("MARKED")
tick 2
lua bar, beat = music_beat()
expect_lua bar == 1 and beat == 1
tick 33
lua bar, beat = music_beat()
expect_lua bar == 2
tick 36
expect_lua music_time() ~= nil and music_time() > 1.0
lua music()
tick 70
# a module asked for at the bar while nothing plays starts at once; a plain music() drops one waiting
lua music("LOOP", 0, {at = "bar"})
expect_lua music_queued() == false and music_beat() ~= nil
lua music("LOOP", 0, {at = "bar"})
expect_lua music_queued() == true
lua music()
expect_lua music_queued() == false
tick 2
expect_lua music_beat() == nil
expect_ok
