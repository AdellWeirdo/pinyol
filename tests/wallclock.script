# clock(): the date and time from the wall clock, worked out by the engine (no C library on the way: the console has none to ask), checked
# against Python's datetime: a leap day turned into the next one by an hour's offset and kept by five hours the other way, the year 2000 (leap,
# a century), before 1970 (days -1), a new year, fourteen hours ahead, the year 2100 (not leap: its 1st of March is day 60). nil when the machine knows no date.
new
lua function same(c, w) return c.year == w[1] and c.month == w[2] and c.day == w[3] and c.hour == w[4] and c.min == w[5] and c.sec == w[6] and c.wday == w[7] and c.yday == w[8] end
clock 1709251199 60
expect_lua same(clock(), {2024, 3, 1, 0, 59, 59, 5, 61}) and clock().days == 19783 and clock().offset == 60
clock 1709251199 -300
expect_lua same(clock(), {2024, 2, 29, 18, 59, 59, 4, 60}) and clock().days == 19782 and clock().offset == -300
clock 951782400 0
expect_lua same(clock(), {2000, 2, 29, 0, 0, 0, 2, 60}) and clock().days == 11016 and clock().offset == 0
clock 0 -60
expect_lua same(clock(), {1969, 12, 31, 23, 0, 0, 3, 365}) and clock().days == -1 and clock().offset == -60
clock 1767225600 0
expect_lua same(clock(), {2026, 1, 1, 0, 0, 0, 4, 1}) and clock().days == 20454 and clock().offset == 0
clock 1798761599 840
expect_lua same(clock(), {2027, 1, 1, 13, 59, 59, 5, 1}) and clock().days == 20819 and clock().offset == 840
clock 4102444800 0
expect_lua same(clock(), {2100, 1, 1, 0, 0, 0, 5, 1}) and clock().days == 47482 and clock().offset == 0
clock 4107542400 0
expect_lua same(clock(), {2100, 3, 1, 0, 0, 0, 1, 60}) and clock().days == 47541 and clock().offset == 0
clock none
expect_lua clock() == nil
clock real
expect_lua clock() == nil or (clock().year >= 2020 and clock().month >= 1 and clock().month <= 12)
expect_ok
