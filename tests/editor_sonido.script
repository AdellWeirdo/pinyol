# sounds brought into the editor from files: the cover's and the first level's music (the same one goes on), an
# effect, a level with none (silence), music changed by a block
tick 30
expect_lua kit.state() == "cover" and kit.playing() == "MUS_tema"
press A
tick 30
expect_lua kit.level() == "nivel1" and kit.playing() == "MUS_tema"
press B
tick 5
lua kit.goto_level("nivel2")
tick 2
expect_lua kit.level() == "nivel2" and kit.playing() == nil
lua kit.music("tema")
tick 2
expect_lua kit.playing() == "MUS_tema"
lua kit.music(nil)
expect_lua kit.playing() == nil
expect_ok
