# Veloz: the Mode 7 title, running (it takes a while to reach speed), a jump rolled into a ball, gems, a beetle
# broken by rolling into it, a beetle that takes the gems away (they fly and can be caught again), a spring, the goal
tick 30
expect_lua state == "title"
shot titulo
press A
expect_lua state == "play"
hold RIGHT 60
expect_lua P.vx > 3 and P.x > 100
shot carrera
press A
tick 4
expect_lua P.ball and not P.ground
tick 40
lua P.x, P.y, P.vx = gems[1].x - 8, gems[1].y - 10, 0
tick 2
expect_lua carried >= 1
lua b = beetles[1] cam = b.x - 100 P.x, P.y, P.vy, P.ball, P.ground = b.x, b.y - 20, 2, true, false
tick 3
expect_lua b.dead > 0
lua b = beetles[2] cam = b.x - 100 P.x, P.y, P.vy, P.vx, P.ball, P.ground, P.hurt = b.x - 4, b.y, 0, 0, false, true, 0
lua carried = 5
tick 2
expect_lua carried == 0 and P.hurt > 0
shot gemas
lua b.dead = 1
tick 100
expect_lua P.dead == 0
lua s = springs[2] cam = s.x - 100 P.x, P.y, P.vy, P.vx, P.hurt = s.x - 8, s.y - 30, 1, 0, 0
tick 6
expect_lua P.vy < -5
lua P.x, P.y, P.vy, P.vx, cam = 188 * 8, 96, 0, 2, 180 * 8 - 120
tick 30
expect_lua state == "won"
shot meta
expect_ok
