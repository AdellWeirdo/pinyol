# Puzle: the shuffle, the d-pad and the touch screen, the hint, solving it, the record
new
tick 5
expect_lua state == "title" and board[0] == 0 and gap == 15
shot puzle_title
press A
tick 140
expect_lua state == "play" and moves == 0
shot puzle_play
# the hint shows the picture over the pieces while C is held
hold C 3
# one move from solved: the gap at the third cell of the last row, the last piece on its right
lua for c = 0, 15 do board[c] = c end
lua board[14], board[15], gap = 15, 14, 14
press UP
expect_lua moves == 0
press LEFT
tick 2
expect_lua state == "solved" and moves == 1 and stored("best_moves") == 1
tick 60
shot puzle_solved
# again, now with a finger: one move from solved, the gap where piece 11 goes and that piece under it. A piece far
# from the gap does not move; the one under it (cell 15, at screen 272, 268) does
press A
tick 140
expect_lua state == "play"
lua for c = 0, 15 do board[c] = c end
lua board[11], board[15], gap = 15, 11, 11
tap 40 40
expect_lua moves == 0 and state == "play" and gap == 11
tap 272 268
tick 2
expect_lua state == "solved" and moves == 1
expect_ok
