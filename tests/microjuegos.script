# a run played by the bots: from the title's "Demostración" to the boss
lua SC.go(RUN.title, nil, {clean = true})
tick 10
press DOWN
press A
tick 20
expect_lua run.bot and run.lives == 4 and run.played == 0
lua played = {}; local u = _update; function _update() u(); if SC.top() == RUN.play and RUN.current then played[RUN.current.verb] = true end end
tick 3500
expect_lua SC.top() == RUN.title and cnt(played) >= 5 and played["¡JEFE!"]
expect_lua stored("best") >= 1300
# a run that loses every game: the lives go, one a game, and it ends
lua run = RUN.new(true, true); SC.go(RUN.interlude, nil, {clean = true})
tick 20
expect_lua run.lives == 4
lua lost_at = {}; local u2 = _update; function _update() u2(); if SC.top() == RUN.over and not lost_at.t then lost_at.t = run.played; lost_at.lives = run.lives end end
tick 2000
expect_lua lost_at.lives == 0 and lost_at.t >= 4 and lost_at.t <= 13
expect_ok
