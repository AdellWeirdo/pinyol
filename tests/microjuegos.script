# microjuegos: a whole run played by the games' own bots (to the boss, with all its lives and a faster speed on the way), a run that
# loses every game (the lives go, the game ends), and the cleaning between games: after each microgame (each leaves something on the
# picture or the sound) a plain scene is drawn and its frame is compared with the one drawn from nothing (the CMake test does it).
new
tick 5
lua RUN = require("run"); SC = require("scene"); function cnt(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
expect_lua SC.top() == RUN.title and cnt(RUN.games) == 7 and RUN.boss.boss
# the cleaning: the probe, from nothing
lua PR = {enter = function() bg(3, {map = "BG1", prio = 3, wrap = false, mosaic = true}); palette("WORLD"); palette("OBJ", true); spr(0, sheet("THINGS"), 0, 100, 60, MOSAIC) end, draw = function() rect(20, 20, 60, 20, 0x80C080) end}
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_0
# each microgame, stained, then the probe
lua function stain(i) run = RUN.new(true); SC.go(i == 8 and RUN.play or RUN.play, {game = i == 8 and RUN.boss or RUN.games[i]}, {clean = true}) end
lua stain(1)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_1
lua stain(2)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_2
lua stain(3)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_3
lua stain(4)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_4
lua stain(5)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_5
lua stain(6)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_6
lua stain(7)
tick 36
expect_led FF2000
lua SC.go(PR, nil, {clean = true})
tick 3
expect_led off
shot leak_7
lua stain(8)
tick 36
lua SC.go(PR, nil, {clean = true})
tick 3
shot leak_8
