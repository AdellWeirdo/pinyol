# the credits: they scroll, and A at the end goes back to the title
lua require("core.cine").run(function() end) require("core.events").start_credits() G.state = "credits"
tick 200
expect_lua G.state == "credits" and require("core.events").credits_t > 150
tick 70
press A+B
tick 10
expect_lua G.state == "title"
expect_ok
