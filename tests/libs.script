# The libraries every game can require: juice (tweens, shake, freeze, flash), particles, physics, keyboard
new
tick 2
expect_lua type(juice.tween) == "function" and type(physics.world) == "function"
# juice: a tween reaches its target with the ease's shape; freeze stops the game's tick; shake moves the camera
lua juice.tween(door, {y = 100}, 0.5, "out_quad")
tick 15
expect_lua door.y > 60 and door.y < 100
tick 20
expect_lua door.y == 100 and not juice.busy(door)
lua juice.freeze(10) before = ball.y
tick 5
expect_lua ball.y == before
tick 10
lua juice.shake(8) ox, oy = juice.offset()
expect_lua math.abs(ox) <= 8 and math.abs(oy) <= 8
expect_lua_error juice.tween(door, {y = 0}, 1, "no_such_ease")
# particles: a burst, then they die out
lua fx:burst(200, 100, 50, {speed = 3, colours = {0xFFFFFF, 0xFF8030}, life = 20, gravity = 0.1})
expect_lua fx:count() == 50
tick 45
expect_lua fx:count() == 0
# physics: the ball and the box fall onto the floor and rest there; the rope holds the bob within its length
tick 200
expect_lua math.abs(ball.y + ball.r - 300) < 2 and math.abs(box.y + box.h - 300) < 2 and math.abs(ball.vy) < 0.5
expect_lua hits > 0
expect_lua math.sqrt((bob.x - anchor.x) ^ 2 + (bob.y - anchor.y) ^ 2) < 62
expect_lua world:at(ball.x, ball.y) == ball and world:at(5, 5) == nil
lua world:remove(box)
expect_lua world:at(170, 290) ~= box
shot physics
# keyboard: right twice from Q to E, A types it; B rubs out; START is done
lua writing = true
press RIGHT
press RIGHT
press A
expect_lua kb.text == "E"
press A
press B
expect_lua kb.text == "E"
press START
tick 2
expect_lua result == "ok"
shot keyboard
expect_ok
# juice: trauma shakes by its square and wears off; a kick eases back; a spring chases its target and settles; a squash
# squeezes and springs back to 1
lua juice.trauma(1) ox, oy, ang = juice.offset()
expect_lua ox ~= nil and oy ~= nil and ang ~= nil
tick 60
lua ox, oy = juice.offset()
expect_lua ox == 0 and oy == 0
lua juice.kick(10, 0) ox = juice.offset()
expect_lua ox == 10
tick 20
lua ox = juice.offset()
expect_lua ox == 0
lua sp = juice.spring(3, 0.5, 0) top = 0 for i = 1, 20 do top = math.max(top, sp:update(100)) end
expect_lua top > 100
lua for i = 1, 200 do sx = sp:update(100) end
expect_lua math.abs(sx - 100) < 0.5
lua hero = {} juice.squash(hero, 0.3)
expect_lua math.abs(hero.sx - 1.3) < 1e-6 and math.abs(hero.sy - 1 / 1.3) < 1e-6
tick 10
expect_lua hero.sx == 1 and hero.sy == 1
# sfx's variation and limits: max playing at once, a cooldown, a varied pitch still plays; the buses and a duck run
lua h1 = sfx("BEEP", 1, {max = 1, loop = true}) h2 = sfx("BEEP", 1, {max = 1})
expect_lua h1 ~= 0 and h2 == 0
lua sfx_stop(h1)
lua c1 = sfx("BEEP", 0.5, {cooldown = 0.5}) c2 = sfx("BEEP", 0.5, {cooldown = 0.5})
expect_lua c1 ~= 0 and c2 == 0
tick 31
expect_lua sfx("BEEP", 0.5, {cooldown = 0.5, pitch_var = 3, gain_var = 0.2}) ~= 0
lua bus("music", {gain = 0.5, lowpass = 800, fade = 0.2}) bus("sfx", {gain = 0.7}) bus("ambient") duck({to = 0.2, hold = 0.3})
expect_lua_error bus("drums")
# voice: a blip every second letter, none for spaces and marks; rich types with it
expect_lua abuela:say("h") == false and abuela:say("o") == true and abuela:say(" ") == false and abuela:say("l") == false and abuela:say("a") == true
lua abuela:reset() said = 0 r = rich.new("hola mundo", {speed = 1, blip = function(ch) if abuela:say(ch) then said = said + 1 end end})
lua for i = 1, 12 do r:update() end
expect_lua said == 4
# brain: the best-scoring action, kept unless another beats it by the margin; enter, update and exit run; force
lua e = {hp = 10, near = false, log = {}}
lua b = brain.new({flee = {score = function(x) return x.hp < 3 and 1 or 0 end, enter = function(x) x.log[#x.log + 1] = "flee" end}, attack = {score = function(x) return x.near and 0.8 or 0 end, update = function(x) x.hits = (x.hits or 0) + 1 end}, wander = {score = 0.1, exit = function(x) x.log[#x.log + 1] = "left wander" end}}, {every = 5, stick = 0.15})
lua b:update(e)
expect_lua b.current == "wander" and b:think(e) == "wander"
lua e.near = true for i = 1, 6 do b:update(e) end
expect_lua b.current == "attack" and e.hits >= 1 and e.log[1] == "left wander"
lua e.hp = 2 for i = 1, 6 do b:update(e) end
expect_lua b.current == "flee" and e.log[2] == "flee" and b.since >= 1
lua b:force("wander", e)
expect_lua b.current == "wander"
# rng: a seed gives the same numbers again, another seed others; ranges hold; hash is a function of its index
lua r1, r2, r3 = rng.new(7), rng.new(7), rng.new(8) a, b2, c = r1:int(1, 6), r2:int(1, 6), r3:int(1, 6)
expect_lua a == b2 and a >= 1 and a <= 6
lua same = true for i = 1, 50 do if r1:int(100) ~= r2:int(100) then same = false end end
expect_lua same
lua ok = true for i = 1, 200 do local v = r3:float(2, 5) if v < 2 or v >= 5 then ok = false end end
expect_lua ok and rng.hash(5, 1) == rng.hash(5, 1) and rng.hash(5, 1) ~= rng.hash(6, 1) and rng.hash(3) < 1
lua t = {1, 2, 3, 4, 5} r3:shuffle(t) sum = 0 for _, v in ipairs(t) do sum = sum + v end
expect_lua sum == 15 and r3:pick({"a"}) == "a" and math.abs(rng.fbm(1.5, 2.5)) <= 1
# gen: caves have open cells and a solid border; bsp has rooms, all joined; a walk tunnels; spelunky's rooms make a path
lua m = gen.caves(40, 30, {seed = 3})
expect_lua m:count(0) > 100 and m:get(0, 0) == 1 and m:get(39, 29) == 1 and m:get(-1, 5) == 1
lua m2 = gen.bsp(50, 40, {seed = 5}) before = m2:count(0) gen.connected(m2)
expect_lua rawlen(m2.rooms) >= 2 and m2:count(0) == before
lua m3 = gen.walk(30, 30, {seed = 2, steps = 400})
expect_lua m3:count(0) > 50 and m3:get(15, 15) == 0
lua rooms = gen.spelunky(4, 4, {seed = 9}) drops = 0 for y = 1, 4 do for x = 1, 4 do if rooms[y][x] == 2 then drops = drops + 1 end end end
expect_lua drops == 3
# chain: the body follows the head keeping its links' length and bend; a two-bone elbow keeps both lengths; FABRIK reaches
lua w = chain.new(6, 8, {bend = 30, x = 100, y = 100}) w:follow(120, 100) w:follow(130, 110)
lua d = math.sqrt((w.points[1].x - w.points[2].x) ^ 2 + (w.points[1].y - w.points[2].y) ^ 2)
expect_lua math.abs(d - 8) < 1e-3 and w.points[1].x == 130
lua ex, ey = chain.two_bone(0, 0, 10, 10, 12, 0)
expect_lua math.abs(math.sqrt(ex * ex + ey * ey) - 10) < 1e-3 and math.abs(math.sqrt((ex - 12) ^ 2 + ey ^ 2) - 10) < 1e-3
lua pts = {{x = 0, y = 0}, {x = 10, y = 0}, {x = 20, y = 0}, {x = 30, y = 0}} reached = chain.fabrik(pts, {10, 10, 10}, 15, 15)
expect_lua reached and math.abs(pts[4].x - 15) < 0.5 and math.abs(pts[4].y - 15) < 0.5 and pts[1].x == 0
lua leg = chain.leg({hip = w.points[2], len = 10, side = 1, stride = 6}) for i = 1, 30 do w:follow(130 + i * 2, 110) leg:update() end
expect_lua leg.steps >= 1
# steer: seek moves towards the target, flee away, arrive stops near it, flocking keeps birds apart
lua e = {x = 0, y = 0, vx = 0, vy = 0, max_speed = 2, max_force = 0.5} for i = 1, 30 do steer.apply(e, steer.seek(e, 100, 0)) end
expect_lua e.x > 30 and math.abs(e.y) < 1
lua f = {x = 50, y = 0, vx = 0, vy = 0, max_speed = 2, max_force = 0.5} for i = 1, 20 do steer.apply(f, steer.flee(f, 0, 0)) end
expect_lua f.x > 60
lua a = {x = 0, y = 0, vx = 0, vy = 0, max_speed = 3, max_force = 0.3} for i = 1, 300 do steer.apply(a, steer.arrive(a, 100, 50, 40)) end
expect_lua math.abs(a.x - 100) < 2 and math.abs(a.y - 50) < 2 and math.abs(a.vx) < 0.5
lua birds = {} for i = 1, 20 do birds[i] = {x = 100 + i, y = 100 + (i % 3) * 2, vx = 1, vy = 0, max_speed = 2, max_force = 0.2} end
lua for t = 1, 60 do for _, bd in ipairs(birds) do steer.apply(bd, steer.flock(bd, birds, {radius = 30})) end end
lua close = 0 for i = 1, 20 do for j = i + 1, 20 do if math.abs(birds[i].x - birds[j].x) + math.abs(birds[i].y - birds[j].y) < 2 then close = close + 1 end end end
expect_lua close < 10
lua h = steer.hash(32) h:rebuild(birds) near = h:near(birds[1], 32)
expect_lua rawlen(near) >= 1
lua wv = {x = 0, y = 0, vx = 1, vy = 0, max_speed = 2, max_force = 0.2} for i = 1, 10 do steer.apply(wv, steer.wander(wv)) end
expect_lua wv.x > 0
