# tablero: the rules (reach round the enemy and over terrain, a bow's range, a counter-blow, the danger layer), a turn played with the
# buttons (cancel, a move into the water refused, wait, end turn, red answers), a whole battle between the two AIs with invariants checked
# each tick, and the saved battle that the title continues.
new
tick 5
lua R = require("rules"); AI = require("ai"); D = require("data"); S = require("scene"); st = R.new_game(D); function cnt(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end
expect_lua cnt(st.units) == 8 and st.side == "blue" and st.turn == 1
expect_lua R.damage(R.unit(st, 1), R.unit(st, 5), 0) == 5 and R.damage(R.unit(st, 3), R.unit(st, 5), 2) == 2 and R.damage({kind = 1}, {kind = 0}, 9) == 1
expect_lua cnt(R.reach(st, R.unit(st, 1))) == 26 and R.reach(st, R.unit(st, 1))[1].x == 1
lua function in_reach(u, x, y) for _, c in ipairs(R.reach(st, u)) do if c.x == x and c.y == y then return true end end return false end
lua function in_reach2(state, u, x, y) for _, c in ipairs(R.reach(state, u)) do if c.x == x and c.y == y then return true end end return false end
expect_lua in_reach(R.unit(st, 1), 4, 3) and not in_reach(R.unit(st, 1), 7, 4) and not in_reach(R.unit(st, 1), 2, 4)
expect_lua not in_reach(R.unit(st, 4), 10, 6) and in_reach(R.unit(st, 4), 9, 6) and in_reach(R.unit(st, 4), 7, 6)
# a red sword on the bridge shuts the road: blue's sword cannot cross it; with the bridge free it can
lua blk = R.move(R.move(st, 1, 5, 3), 5, 7, 3); open_ = R.move(st, 1, 5, 3)
expect_lua in_reach2(open_, R.unit(open_, 1), 8, 3) and not in_reach2(blk, R.unit(blk, 1), 8, 3) and in_reach2(blk, R.unit(blk, 1), 6, 3)
# a blow on a forest cell is one less (the defence the terrain adds)
lua frs, evf = R.strike(R.move(R.move(st, 1, 10, 4), 5, 11, 4), 1, 5)
expect_lua evf[1].dmg == 4 and R.terrain_at(st, 11, 4).def == 1
lua st2 = R.move(R.move(st, 3, 5, 6), 5, 7, 6)
expect_lua cnt(R.targets(st2, R.unit(st2, 3), 5, 6)) == 1 and cnt(R.targets(st2, R.unit(st2, 3), 6, 6)) == 0
lua st3, ev = R.strike(R.move(R.move(st, 1, 5, 3), 5, 6, 3), 1, 5)
expect_lua ev[1].kind == "hit" and ev[1].dmg == 5 and ev[2].kind == "counter" and R.unit(st3, 5).hp == 15 and R.unit(st3, 1).hp == 15
lua st4, ev4 = R.strike(R.move(R.move(R.move(st, 1, 5, 3), 5, 6, 3), 5, 6, 3), 1, 5); st4 = R.move(st4, 5, 6, 3); st5, ev5 = R.strike(R.strike(R.strike(st4, 1, 5), 1, 5), 1, 5)
expect_lua R.unit(st5, 5) == nil and cnt(st5.units) == 7
lua dg = R.danger(st, "red")
expect_lua dg:get(9, 3) >= 1 and dg:get(0, 0) == 0
lua e1 = R.end_turn(R.finish(st, 1))
expect_lua e1.side == "red" and e1.turn == 1 and not R.unit(e1, 1).acted and R.end_turn(e1).turn == 2
# the AI decides from what it sees: the nearest road cell, or a blow when one is in reach
lua d = AI.decide(st, R.unit(st, 5))
expect_lua d.x == 9 and d.y == 3 and d.target == nil
lua d2 = AI.decide(R.move(st, 1, 10, 3), R.unit(st, 5))
expect_lua d2.target == 1
# the title, a new battle, a turn with the buttons
expect_lua S.top() == require("title")
press A
tick 40
expect_lua S.top() == require("play") and game.state.side == "blue"
press A
tick 2
expect_lua game.cur.x == 1 and game.cur.y == 3 and game.phase == "move"
press B
tick 2
expect_lua game.phase == "select"
press A
tick 2
press RIGHT
press RIGHT
press RIGHT
tick 2
press A
tick 60
expect_lua game.phase == "menu"
press A
tick 2
expect_lua R.unit(game.state, 1).x == 4 and R.unit(game.state, 1).acted
press START
tick 700
expect_lua game.state.side == "blue" and game.state.turn == 2
expect_lua R.unit(game.state, 5).x < 13 and stored("save").turn == 2 and stored("save").side == "blue"
# a move onto the water is refused: the phase stays "move"
press A
tick 2
expect_lua game.phase == "move"
press RIGHT
press RIGHT
press RIGHT
press DOWN
tick 2
expect_lua game.cur.x == 7 and game.cur.y == 4
press A
tick 2
expect_lua game.phase == "move" and R.unit(game.state, 1).x == 4
press B
tick 2
expect_lua game.phase == "select"
# the demonstration: both sides by the AI, to the end
lua S.go(require("title"))
tick 40
expect_lua stored("save").turn == 2
press A
tick 40
expect_lua S.top() == require("play") and game.state.turn == 2 and R.unit(game.state, 1).x == 4 and not game.auto_blue
lua S.go(require("title"))
tick 40
press DOWN
press A
tick 20
lua bad, last_units, seen = 0, 99, 0
lua function watch() local st = game.state; local seen_cell = {}; for _, u in ipairs(st.units) do local k = u.y * 100 + u.x; if seen_cell[k] or R.terrain_at(st, u.x, u.y).cost == 0 or u.hp <= 0 or u.hp > R.KINDS[u.kind].hp then bad = bad + 1 end seen_cell[k] = true end; if cnt(st.units) > last_units then bad = bad + 1 end last_units = cnt(st.units) end
lua local u = _update; function _update() u(); watch() end
tick 4000
expect_lua game.winner ~= nil and bad == 0 and game.state.turn >= 3
expect_lua S.top() == require("play") and stored("save") == nil
press A
tick 60
expect_lua S.top() == require("title")
expect_ok
