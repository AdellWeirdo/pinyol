# Sonidos: sounds made from numbers and recipes, played at a pitch and looped, changed while they play, and music in
# layers; the limits of sound()
new
tick 3
expect_lua toy == 1 and made ~= nil and made.wave ~= nil and made.freq > 0
# a recipe and a seed always give the same sound; another seed, another sound
press A
expect_lua seed == 2
lua a = sound("T1", "laser", 5) b = sound("T2", "laser", 5) c = sound("T3", "laser", 6)
expect_lua a.freq == b.freq and a.slide == b.slide and a.freq ~= c.freq
# made from a table: missing numbers take defaults, wrong ones are made safe
lua d = sound("T4", {wave = "noise", freq = 1e9, sustain = 99, decay = -1, volume = 0 / 0})
expect_lua d.freq == 20000 and d.attack + d.sustain + d.decay <= 4 and d.volume == 0
shot fabrica
# a sound playing in a loop, its pitch and gain changed, then stopped
lua h = sfx("T1", 0.5, {loop = true, pitch = 2})
expect_lua h ~= 0 and sfx_on(h)
tick 300
expect_lua sfx_on(h)
lua sfx_set(h, {pitch = 0.5, gain = 0.2}) sfx_stop(h)
expect_lua not sfx_on(h)
# a one-shot ends by itself
lua h2 = sfx("T1")
tick 300
expect_lua not sfx_on(h2)
# the toys
press C
hold A 30
expect_lua toy == 2
shot theremin
press C
hold A 60
expect_lua toy == 3 and car.speed > 2
shot motor
press C
expect_lua toy == 4 and layers[1] and not layers[2]
press UP
expect_lua layers[2]
shot capas
# limits
expect_lua_error sound("../x", "coin")
expect_lua_error sound("X", "nothing")
expect_lua_error sound("X", 5)
expect_lua_error music_layer(9, 1)
expect_lua_error for i = 1, 40 do sound("BIG" .. i, {sustain = 4, decay = 0}) end
expect_ok
