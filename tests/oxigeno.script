tick 2
lua astronaut.x, astronaut.y = 13 * 8, 7 * 8
tick 2
lua astronaut.x, astronaut.y = 5 * 8, 12 * 8
tick 2
lua astronaut.x, astronaut.y = 22 * 8, 12 * 8
tick 2
expect_lua bottles == 0
lua astronaut.x, astronaut.y = 25 * 8, 13 * 8
