# Carga, exploración, oxígeno, robots, derrota y misión cumplida.
tick 60
expect_lua state == "load"
shot piloto
tick 200
shot datos
tick 200
shot portada
press A
expect_lua state == "play" and bottles == 5 and air > 0.9
lua old_x = astronaut.x
hold RIGHT 12
expect_lua astronaut.x > old_x
shot estacion
lua air = 0.4
lua astronaut.x, astronaut.y = 5 * 8, 3 * 8
