lua astronaut.x, astronaut.y, astronaut.invuln = robots[1].x, robots[1].y, 0
lua old_air = air
tick 1
expect_lua air < old_air and astronaut.invuln > 0
lua old_air = air
tick 3
expect_lua air > old_air - 0.01
lua air = 0.0001
tick 2
expect_lua state == "over"
shot sin_aire
press A
expect_lua state == "play" and bottles == 5
lua astronaut.x, astronaut.y = 5 * 8, 3 * 8
tick 2
