# The Lua sandbox: limits that keep a community game from hurting the console.
new
tick 10
expect_ok
expect_lua ticks_seen >= 10
expect_lua helper_value() == 42
expect_lua io == nil and os == nil and debug == nil and package == nil
expect_lua dofile == nil and loadfile == nil and string.dump == nil
expect_lua collectgarbage("generational") == "generational"
expect_lua load(string.char(27) .. "Lua") == nil
expect_lua load("return 1 + 1")() == 2
expect_lua_error require("../../etc/passwd")
expect_lua_error spin()
expect_lua_error escape()
expect_lua_error tailspin()
expect_lua_error forspin()
expect_lua_error genspin()
expect_lua_error repspin()
expect_lua_error gotospin()
expect_lua_error cospin()
expect_lua type(busy()) == "number"
expect_lua helper_value() == 42
expect_lua_error hog()
lua store("best", 1234)
expect_lua stored("best") == 1234
expect_lua stored("missing", "x") == "x"
lua math.randomseed(7) first = math.random(1000)
lua math.randomseed(7)
expect_lua math.random(1000) == first
lua tone(0, "C4", {wave = "triangle", decay = 0.1})
lua tone(1, 880, {wave = "noise", sustain = 1, len = 0.05})
lua tone(0)
expect_lua math.abs(note("A4") - 440) < 0.01 and note("Q4") == 0
expect_lua_error tone(4, 440)
expect_lua_error tone(0, "X9")
expect_lua_error tone(0, 440, {wave = "piano"})
lua lh = select(2, textw("x"))
lua w, h = text("uno dos tres cuatro cinco seis siete ocho", 0, 0, 0xFFFFFF, "main", "left", 80)
expect_lua w <= 80 and w > 0 and h >= 3 * lh
lua w1, h1 = text("una línea", 0, 0)
expect_lua h1 == lh and w1 == textw("una línea")
lua text("añadiendo letras", 0, 0, 0xFFFFFF, "main", "left", 0, 3)
lua store("inv", {items = {"llave", "mapa"}, gold = 25, flags = {door = true}, empty = {}})
lua inv = stored("inv")
expect_lua inv.items[2] == "mapa" and inv.gold == 25 and inv.flags.door == true and next(inv.empty) == nil
expect_lua math.type(stored("inv").gold) == "integer" and math.type(stored("best")) == "integer"
lua loop = {} loop.self = loop
expect_lua_error store("loop", loop)
expect_lua_error store("bad", {[5] = 1, x = 2})
expect_lua_error store("fn", {f = print})
expect_lua_error store("big", string.rep("x", 70000))
expect_lua stored("big") == nil and stored("loop") == nil and stored("inv").gold == 25
lua store("inv", nil)
expect_lua stored("inv", 7) == 7
lua u = {1, 2, 3} for d = 1, 15 do u = {u, u, u} end
expect_lua_error store("fan", u)
expect_lua stored("fan") == nil and stored("best") == 1234
expect_ok
