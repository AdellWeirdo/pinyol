# The LED: a game's colour, then the console's own again (led()), and when the game ends; the battery: its level and
# charging, or nil where it cannot be told
new
tick 2
expect_led off
press A
expect_led ff0000
shot device_on_air
press A
expect_led off
lua led(0x00FF00)
expect_led 00ff00
new
tick 1
expect_led off
battery 0.42 charging
tick 1
expect_lua math.abs(level - 0.42) < 1e-6 and charging == true
battery 1.5
tick 1
expect_lua level == 1 and charging == false
battery none
tick 1
expect_lua level == nil and battery() == nil
battery real
expect_lua_error led("red")
# MENU reaches a Lua game as MENU, never as START
press MENU
expect_lua menus == 1 and starts == 0
press START
expect_lua menus == 1 and starts == 1
expect_ok
# tilt: none here; a tilted console reads so, relative to the neutral position tilt_zero() takes; rumble is asked for
expect_lua tilt() == nil
tilt 0.5 -0.25 0.8
expect_lua tilt_now() == 0.5 and ty == -0.25 and tz == 0.8
lua tilt_zero()
tilt 0.5 -0.25 0.8
expect_lua tilt_now() == 0 and ty == 0 and tz == 0.8
tilt 0.7 -0.25 0.8
lua tilt_now()
expect_lua math.abs(tx - 0.2) < 1e-6
lua tilt_zero(false)
expect_lua tilt_now() == 0.7
tilt none
expect_lua tilt() == nil
lua rumble(120, 0.5)
expect_rumble 120
expect_rumble 0
expect_ok
