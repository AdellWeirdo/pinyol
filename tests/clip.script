# Clips: a frame at a time at the clip's own rate (15 fps: one every 4 ticks), on its canvas; seeking forwards and
# back (from the keyframe before), backwards, faster, paused, looping, stopping at the end; closed; broken files
# fail to open or play wrong, never crash
new
tick 1
lua tv = video("demo", {loop = true})
expect_lua tv:frame() == 0 and on(0) and tv:frames() == 40 and tv:fps() == 15
tick 4
expect_lua tv:frame() == 1 and on(1)
tick 40
expect_lua tv:frame() == 11 and on(11)
shot clip
lua tv:seek(30)
expect_lua on(30)
lua tv:seek(3)
expect_lua on(3)
lua tv.speed = -1
tick 8
expect_lua tv:frame() == 1 and on(1)
lua tv.speed = 2
tick 20
expect_lua tv:frame() == 11 and on(11) and tv.speed == 2
lua tv:pause() n = tv:frame()
tick 20
expect_lua tv:frame() == n and not tv:playing()
lua tv:play() tv.speed = 4 tv:seek(36)
tick 4
expect_lua tv:frame() == 0 and on(0)
lua once = video("demo", {canvas = "ONCE"}) once:seek(37)
tick 20
expect_lua not once:playing() and once:frame() == 39 and on(39, "ONCE")
lua once:close()
expect_lua_error once:frame()
expect_lua_error video("nope")
expect_lua_error video("../x")
expect_lua_error video("demo", {canvas = "ONCE2", speed = "x"})
expect_lua_error tv.colour = 3
lua opened, failed = try_bad()
tick 30
expect_lua failed >= 6 and opened + failed == 22
expect_ok
