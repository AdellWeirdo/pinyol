new
tick 2
expect_ok
lua len = function(t) local c = 0; for _ in ipairs(t) do c = c + 1 end; return c end; R = require("reglas"); J = require("juego"); N = require("niveles"); A = require("auto")
# a group of 3 in a row, and an L merges into one group of 5
lua b = {cols=8, filas=7, g={}}; for r=1,7 do b.g[r]={} end; b.g[7][1]="rojo"; b.g[7][2]="rojo"; b.g[7][3]="rojo"; ok1 = len(R.grupos(b)) == 1 and len(R.grupos(b)[1].celdas) == 3
expect_lua ok1
lua b.g[6][1]="rojo"; b.g[5][1]="rojo"; gs = R.grupos(b); ok2 = len(gs) == 1 and len(gs[1].celdas) == 5
expect_lua ok2
# two in a row are not a group; a blocker never forms one
lua b = {cols=8, filas=7, g={}}; for r=1,7 do b.g[r]={} end; b.g[7][1]="azul"; b.g[7][2]="azul"; b.g[7][3]="esponja"; ok3 = len(R.grupos(b)) == 0
expect_lua ok3
lua b.g[7][3]="azul"; b.g[7][4]="esponja"; b.g[7][5]="esponja"; b.g[7][6]="esponja"; ok3b = len(R.grupos(b)) == 1
expect_lua ok3b
# a swap with no group is refused and the board is as it was
lua b = {cols=8, filas=7, g={}}; for r=1,7 do b.g[r]={} end; b.g[7][1]="rojo"; b.g[7][2]="azul"; ok4 = R.intercambiar(b,7,1,7,2) == false and b.g[7][1]=="rojo" and b.g[7][2]=="azul"
expect_lua ok4
# a swap that makes a group is kept
lua b = {cols=8, filas=7, g={}}; for r=1,7 do b.g[r]={} end; b.g[7][1]="rojo"; b.g[7][2]="rojo"; b.g[7][3]="azul"; b.g[7][4]="rojo"; ok5 = R.intercambiar(b,7,3,7,4) and b.g[7][3]=="rojo"
expect_lua ok5
# a blocker cannot swap
lua b.g[7][5]="esponja"; ok6 = R.vecinas(b,7,4,7,5) == false
expect_lua ok6
# a burst takes the blocker beside it
lua b = {cols=8, filas=7, g={}}; for r=1,7 do b.g[r]={} end; for c=1,3 do b.g[7][c]="verde" end; b.g[6][2]="esponja"; q = R.limpiar(b, R.grupos(b)); ok7 = len(q) == 4 and b.g[6][2] == nil
expect_lua ok7
# gravity fills every hole, and the boards of the levels start without groups and with a move
lua ok8 = true; for i, n in ipairs(N) do local bb = R.nuevo(n); if len(R.grupos(bb)) ~= 0 or len(R.jugadas(bb)) == 0 then ok8 = false end end
expect_lua ok8
# the same level twice is the same board
lua x, y = R.nuevo(N[1]), R.nuevo(N[1]); ok9 = true; for r=1,7 do for c=1,8 do if x.g[r][c] ~= y.g[r][c] then ok9 = false end end end
expect_lua ok9
# mixing: ingredients leave, the result arrives, all at once; and not without them
lua s = J.nuevo(N[2]); okm0 = J.mezclar(s, 1) == false; s.stock.rojo = 1; s.stock.amarillo = 1; okm1 = J.mezclar(s, 1); okm = okm0 and okm1 and s.stock.naranja == 1 and s.stock.rojo == 0 and s.stock.amarillo == 0
expect_lua okm
# brush: not enough = refused and nothing consumed; wrong region keeps the load; right region paints
lua s = J.nuevo(N[1]); okp1 = J.cargar(s, 1) == false and s.brush == nil; s.stock.azul = 22; okp2 = J.cargar(s, 1) and s.stock.azul == 2 and s.brush.color == "azul"; okp3 = J.pintar(s, 5) == false and s.brush ~= nil; okp4 = J.pintar(s, 1) and s.obj[1].hecho and s.brush == nil
expect_lua okp1 and okp2 and okp3 and okp4
# reloading another objective gives the first load back
lua s = J.nuevo(N[1]); s.stock.azul = 20; s.stock.amarillo = 16; J.cargar(s, 1); okr = s.stock.azul == 0; J.cargar(s, 2); okr = okr and s.stock.azul == 20 and s.brush.color == "amarillo"
expect_lua okr
# lost when out of moves with nothing to paint with; not lost while the stock can still pay
lua s = J.nuevo(N[1]); s.mov = 0; J.revisar(s); okl1 = s.fin == "pierde"; s = J.nuevo(N[1]); s.mov = 0; s.stock.azul = 20; s.stock.amarillo = 16; J.revisar(s); okl2 = s.fin == nil
expect_lua okl1 and okl2
# craftable stock keeps a level alive: green needs yellow+blue
lua s = J.nuevo(N[3]); s.mov = 0; s.stock.amarillo = 16; s.stock.azul = 40; J.revisar(s); okl3 = s.fin == nil
expect_lua okl3
# every level is winnable: the autopilot wins each one within a few boards (it is not a planner, so not always the first)
lua okw = true; for i, n in ipairs(N) do local gano = false; for k = 0, 5 do local nn = {}; for a, v in pairs(n) do nn[a] = v end; nn.semilla = n.semilla + k * 7919; local r = A.jugar(nn); if r.fin == "gana" then gano = true; log("nivel", i, "gana con la semilla", k, "movs sobrantes", r.mov); break end end; if not gano then okw = false end end
expect_lua okw
# the second painting: its levels are winnable too, and it opens only when the first is done
lua U = require("util"); O = require("obras"); NO = {}; for _, ob in ipairs({O[2], O[3]}) do for _, nv in ipairs(ob.niveles) do NO[#NO + 1] = nv end end; okw2 = true; for i, n in ipairs(NO) do local gano = false; for k = 0, 5 do local nn = {}; for a, v in pairs(n) do nn[a] = v end; nn.semilla = n.semilla + k * 7919; if A.jugar(nn).fin == "gana" then gano = true; break end end; if not gano then okw2 = false; log("sin ganar", n.id) end end
expect_lua okw2
lua G.progreso = {estrellas = {}}; ok_a = U.obra_libre(1) and not U.obra_libre(2); G.progreso.estrellas.noche = {1, 1, 1, 1, 0}; ok_b = not U.obra_libre(2); G.progreso.estrellas.noche = {1, 1, 1, 1, 2}; ok_c = U.obra_libre(2) and U.hechos(O[1]) == 5
expect_lua ok_a and ok_b and ok_c
# the wide brush: a group of 4 leaves one; swapped with a neighbour it clears that row or column
lua function plano() s = J.nuevo(require("niveles_ola")[3]); for r = 1, 7 do for c = 1, 8 do s.b.g[r][c] = ({"azul", "amarillo", "blanco"})[(r * 2 + c) % 3 + 1] end end end
lua plano(); s.b.g[7][1] = "rojo"; s.b.g[7][2] = "rojo"; s.b.g[7][3] = "azul"; s.b.g[7][4] = "rojo"; s.b.g[6][3] = "rojo"; for _, c in ipairs({1, 2, 4, 5}) do s.b.g[6][c] = ({"amarillo", "blanco"})[c % 2 + 1] end; s.b.g[5][3] = "blanco"; okc, infoc = J.cambiar(s, 7, 3, 6, 3); okp1 = okc and s.b.g[7][3] == "pincel" and s.pinceles_creados == 1
expect_lua okp1
lua tot0 = 0; for _, v in pairs(s.stock) do tot0 = tot0 + v end; okd, infod = J.cambiar(s, 7, 3, 7, 4); tot1 = 0; for _, v in pairs(s.stock) do tot1 = tot1 + v end; hay = false; for r = 1, 7 do for c = 1, 8 do if s.b.g[r][c] == "pincel" then hay = true end end end
expect_lua okd and s.pinceles == 1 and tot1 >= tot0 + 7 and not hay
lua plano(); s.b.g[4][2] = "pincel"; okv = J.cambiar(s, 4, 2, 3, 2); n_col = 0; for _, q in ipairs(infoc.pasos) do n_col = n_col + 1 end
expect_lua okv and s.pinceles == 1
# a level without specials never makes one
lua s = J.nuevo(N[1]); okn = true; for i = 1, 6 do local j = R.jugadas(s.b)[1]; if j then J.cambiar(s, j[1], j[2], j[3], j[4]) end end; for r = 1, 7 do for c = 1, 8 do if s.b.g[r][c] == "pincel" then okn = false end end end
expect_lua okn
# the tube: a group of 5 leaves one (only where the level allows it); swapped with a coloured neighbour it clears that colour
lua function plano5() s = J.nuevo(require("niveles_nenufares")[3]); for r = 1, 7 do for c = 1, 8 do s.b.g[r][c] = ({"azul", "amarillo", "blanco"})[(r * 2 + c) % 3 + 1] end end end
lua plano5(); for _, c in ipairs({1, 2, 4, 5}) do s.b.g[7][c] = "rojo" end; s.b.g[7][3] = "azul"; s.b.g[6][3] = "rojo"; for _, c in ipairs({1, 2, 4, 5}) do s.b.g[6][c] = ({"amarillo", "blanco"})[c % 2 + 1] end; s.b.g[5][3] = "blanco"; okt, infot = J.cambiar(s, 7, 3, 6, 3); okt1 = okt and s.b.g[7][3] == "tubo"
expect_lua okt1
lua n_azul0 = 0; for r = 1, 7 do for c = 1, 8 do if s.b.g[r][c] == "azul" then n_azul0 = n_azul0 + 1 end end end; s.b.g[6][3] = "azul"; ok_u, info_u = J.cambiar(s, 7, 3, 6, 3); haytubo = false; for r = 1, 7 do for c = 1, 8 do if s.b.g[r][c] == "tubo" then haytubo = true end end end
expect_lua ok_u and s.tubos == 1 and not haytubo and info_u.tubo
lua plano5(); s.b.g[7][1] = "tubo"; s.b.g[7][2] = "esponja"; ok_v = R.vecinas(s.b, 7, 1, 7, 2) == false
expect_lua ok_v
# a level that only allows brushes makes a brush from 5, not a tube
lua s = J.nuevo(require("niveles_ola")[3]); for r = 1, 7 do for c = 1, 8 do s.b.g[r][c] = ({"azul", "amarillo", "blanco"})[(r * 2 + c) % 3 + 1] end end; for _, c in ipairs({1, 2, 4, 5}) do s.b.g[7][c] = "rojo" end; s.b.g[7][3] = "azul"; s.b.g[6][3] = "rojo"; for _, c in ipairs({1, 2, 4, 5}) do s.b.g[6][c] = ({"amarillo", "blanco"})[c % 2 + 1] end; s.b.g[5][3] = "blanco"; J.cambiar(s, 7, 3, 6, 3); ok_p5 = s.b.g[7][3] == "pincel"
expect_lua ok_p5
expect_ok
