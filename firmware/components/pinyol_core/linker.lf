# The engine's statics (frame kept for "shot", asset cache, flags: ~350 KB) do not fit in internal RAM, so
# pinyol_core's .bss lives in PSRAM; G (game.c, 80 KB, holds the world buffer drawn every frame) and the PPU's registers
# and line buffers (ppu.c, ~10 KB, read for every pixel) stay inside. The PPU's code (~12 KB) runs from IRAM: it is
# the hottest loop on the console, and from flash it fought the Lua VM for the instruction cache. The studio's
# effects (studio_fx.c: the plate's 16-bit buffers, ~18 KB, touched twelve times a sample) are kept inside the same way.
# The PPU's two line-palette builds (layers_lp, layers_plain_lp: ~9 KB, only for a game that calls line_pal) run from
# flash: inside, the radio (link) had no internal RAM left to start.
[scheme:ppu_inside]
entries:
    text -> iram0_text
    rodata -> dram0_data
    bss -> dram0_bss
    common -> dram0_bss

[mapping:pinyol_core_bss]
archive: libpinyol_core.a
entries:
    * (extram_bss)
    game (default)
    ppu (ppu_inside)
    ppu:layers_lp (default)
    ppu:layers_plain_lp (default)
    ppu:sil_apply (default)
    ppu:sil_map (default)
    ppu:line (default)
    studio_fx (ppu_inside)
