CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 16 MB quad flash, 8 MB octal PSRAM inside the ESP32-S3R8 (docs/hardware.md)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# an OTA update that never reaches the game list is rolled back on the next restart (ota.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# the engine allocates small and often (cJSON): keep internal RAM for DMA and the system
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# UART0 pins are taken (IO43 charger sense, IO44 button C): the console is the native USB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# the game's file names are long (KL_INTERACT_B.meta.json)
CONFIG_FATFS_LFN_HEAP=y
# stdio's buffer per open file on FAT: newlib's default is 128 B, and fread then asks the card for a sliver at a time
# (1.6 MB/s measured, with sd.c's fast reads; ~9 MB/s with 8 KB). Each open file holds one, in PSRAM.
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=8192
CONFIG_FATFS_MAX_LFN=255

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Internal RAM is what the radio runs out of first (docs/measurements.md, "Internal RAM and the radio"): the system's
# own non-ISR code runs from flash. Statics leave 83.5 KB of D/IRAM (73 KB with none of this). Not taken:
# CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH gives 13 KB more but needs CONFIG_SPI_MASTER_ISR_IN_IRAM=n (the panel's
# interrupt would wait out flash writes).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# NOT CONFIG_SPI_FLASH_ROM_IMPL=y: the ROM's flash driver gave back 9.6 KB of D/IRAM and corrupted the heap on every flash
# erase (a firmware update from the card: the heap's own check failed right after esp_partition_erase_range, then the
# update died in its verification and the console panicked; with it off, the same firmware updated itself; found
# 2026-10-22, docs/measurements.md). Saves to the flash, a game sent to a console with no card and an update all erase.

# pinyol_core statics go to PSRAM (components/pinyol_core/linker.lf)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The data cache at 32 KB gives the other 32 KB to the heap (internal RAM is what runs out first: the radio, the strips'
# DMA, every task's stack). Measured on the board 2026-10-21 playing trece, duelo, torneo, castells, maqueta, control,
# paleta, horizonte, veloz: the strips and the world take the same with 32 KB as with 64 KB (within 3 %), and a game
# runs with 70 KB of internal RAM free instead of 40 (docs/measurements.md, "The variants on the board").
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# The code and its constants run from PSRAM, not flash (XIP): octal PSRAM at 80 MHz beats quad flash at 80 MHz, so the
# world (Lua and the picture processor) takes 10-30 % less (duelo 1.4 -> 1.0 ms, torneo 1.95 -> 1.55, castells 1.75 ->
# 1.3) and saving to the flash no longer stops the game; it costs 1.7 MB of PSRAM (6.3 -> 4.6 MB free at the menu).
# A game that runs short of PSRAM: turn this off first.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# the Lua VM, the picture processor and the drawing code run from flash at once: 16 KB of instruction cache thrashed
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# The radio (main/link_radio.c, ESP-NOW between consoles) is on only while a game uses link: its buffers in PSRAM,
# few of them, and none of its code in IRAM (the picture processor lives there); no NVS (nothing to remember)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# with PSRAM the send buffers are static (ESP-IDF's rule): ESP-NOW at 20 messages a second needs few of them
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# ESP-NOW sends single frames: no aggregation (it would want more receive buffers)
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
